# ─────────────────────────────────────────────────────────────────────────────
# AURIENTA — Environment Variables Example
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in real values. NEVER commit the real `.env`.
# All secrets are loaded from environment variables at runtime — there are no
# hardcoded secrets in the codebase.
#
# In production (Vercel), these are set via the Vercel project dashboard or CLI.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Turso libSQL) ─────────────────────────────────────────────────
# The Turso database URL. The hostname is a public endpoint; the auth token is
# the secret.
DATABASE_URL=libsql://aurienta-fortleem.aws-us-east-1.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# ── Crypto secrets ─────────────────────────────────────────────────────────
# AES-256-GCM key for PII field-level encryption (nationalIdLast4, TOTP secrets,
# Ed25519 private keys). MUST decode to exactly 32 bytes (44 chars base64).
# Generate with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=your_field_encryption_key_here

# Session/cookie signing secret. Generate with: openssl rand -base64 32
SESSION_SECRET=your_session_secret_here

# ── AI providers ───────────────────────────────────────────────────────────
# At least one primary provider should be configured. The /api/ready endpoint
# reports how many are configured.
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here

# ── App config ─────────────────────────────────────────────────────────────
# The public base URL of the deployment (used for OG tags, sitemap, canonical URLs).
PUBLIC_BASE_URL=https://aurienta.vercel.app

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Sandbox/pilot demo sign-in. Leave unset (or false) in production.
# ALLOW_DEMO_SIGNIN=false

# ── Demo seeder only (scripts/seed-demo-users.ts) ───────────────────────────
# Password for seeded demo users. Set only when running the seeder.
# DEMO_USER_PASSWORD=your_demo_user_password_here

# ── Neon (PostgreSQL read replica / analytics) ────────────────────────────
# Neon is used as an optional PostgreSQL analytics replica. The primary DB
# remains Turso (libSQL). Neon syncs via Prisma's multi-datasource feature
# for read-heavy analytics queries (dashboard stats, audit log aggregation).
# Create at: https://neon.tech
NEON_DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/aurienta?sslmode=require
NEON_DATABASE_POOLER_URL=postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/aurienta?sslmode=require

# ── Inngest (serverless workflow orchestration) ───────────────────────────
# Inngest handles long-running workflows: dispute resolution (6-stage),
# graduation protocol, succession activation, verification SLA timers.
# Create at: https://app.inngest.com
INNGEST_EVENT_KEY=your_inngest_event_key_here
INNGEST_SIGNING_KEY=your_inngest_signing_key_here
INNGEST_API_URL=https://api.inngest.com

# ── Vercel deployment ──────────────────────────────────────────────────────
# Vercel hosts the Next.js app. Set these in the Vercel dashboard.
# NEXT_PUBLIC_VERCEL_URL is auto-set by Vercel.
NEXT_PUBLIC_VERCEL_URL=aurienta.vercel.app

# ── GitHub (CI/CD) ─────────────────────────────────────────────────────────
# GitHub Actions deploy to Vercel on push to main.
# GITHUB_TOKEN is auto-set by GitHub Actions.
