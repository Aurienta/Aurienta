# ─────────────────────────────────────────────────────────────────────────────
# AURIENTA — Environment Variables Example
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in real values. NEVER commit the real `.env`.
# All secrets are loaded from environment variables at runtime — there are no
# hardcoded secrets in the codebase.
#
# In production (Vercel), these are set via the Vercel project dashboard or CLI.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Turso libSQL) ─────────────────────────────────────────────────
# The Turso database URL. The hostname is a public endpoint; the auth token is
# the secret.
DATABASE_URL=libsql://aurienta-fortleem.aws-us-east-1.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# ── Crypto secrets ─────────────────────────────────────────────────────────
# AES-256-GCM key for PII field-level encryption (nationalIdLast4, TOTP secrets,
# Ed25519 private keys). MUST decode to exactly 32 bytes (44 chars base64).
# Generate with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=your_field_encryption_key_here

# Session/cookie signing secret. Generate with: openssl rand -base64 32
SESSION_SECRET=your_session_secret_here

# ── AI providers ───────────────────────────────────────────────────────────
# At least one primary provider should be configured. The /api/ready endpoint
# reports how many are configured.
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── App config ─────────────────────────────────────────────────────────────
# The public base URL of the deployment (used for OG tags, sitemap, canonical URLs).
PUBLIC_BASE_URL=https://aurienta.vercel.app

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Sandbox/pilot demo sign-in. Leave unset (or false) in production.
# ALLOW_DEMO_SIGNIN=false

# ── Demo seeder only (scripts/seed-demo-users.ts) ───────────────────────────
# Password for seeded demo users. Set only when running the seeder.
# DEMO_USER_PASSWORD=your_demo_user_password_here
