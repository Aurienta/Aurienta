  enterpriseId  String
  year          Int
  fiscalYearEnd DateTime
  revenueEgp    Int
  netProfitEgp  Int
  totalAssetsEgp Int
  totalLiabilitiesEgp Int
  auditStatus   String   @default("pending") // pending, audited, published
