// ───────────────────────────────────────────────────────────
// PROOF-OF-SOLVENCY (Blueprint §5.5)
// ───────────────────────────────────────────────────────────
/// 3-level health flag system for Law Firm Client Account reconciliation.
/// Level 1: Pending Reconcile (>0.1% variance, <4h) — internal only
/// Level 2: Escrow Health Flag (>2% or >0.1% for >4h) — all partners
/// Level 3: System Freeze (unauthorized withdrawal or >10%) — all + regulator
model SolvencyAssertion {
  id              String   @id @default(cuid())
  enterpriseId    String
  lawFirmBalanceEgp  Float  // balance reported by law firm
  internalBalanceEgp  Float  // balance in AURIENTA's internal ledger
  varianceEgp     Float    // lawFirmBalance - internalBalance
  variancePct     Float    // variance / internalBalance * 100
  healthLevel     Int      @default(1) // 1=ok, 2=warning, 3=freeze
  assertionHash   String   // SHA-256 of the signed balance assertion
  createdAt       DateTime @default(now())

  enterprise      Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  @@index([enterpriseId])
  @@index([healthLevel])
}

