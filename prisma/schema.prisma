// ───────────────────────────────────────────────────────────
// SECURITY & RELIABILITY LAYER (CTO-AUDIT remediation)
// ───────────────────────────────────────────────────────────

/// Server-side session record — replaces bare-cookie userId auth.
/// Enables revocation, rotation, device tracking, "sign out everywhere".
model Session {
  id            String   @id @default(cuid())
  userId        String
  tokenHash     String   @unique // SHA3-256 of the session token (never store raw)
  issuedAt      DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  ip            String?
  userAgent     String?
  mfaVerifiedAt DateTime?

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

/// Idempotency — replay-safe POSTs for all money-moving endpoints.
model IdempotencyRecord {
  id              String   @id @default(cuid())
  key             String   @unique // caller-supplied Idempotency-Key
  userId          String
  route           String
  requestBodyHash String
  status          Int      // HTTP status of the original response
  responseBody    String
  createdAt       DateTime @default(now())
  @@index([userId])
  @@index([createdAt])
}

/// CRE decision ledger — links every governance/money decision to its policy verdict.
model CreDecision {
  id              String   @id @default(cuid())
  policy          String   // e.g. zero_custody.rego, expense_authority.rego
  allowed         Boolean
  reason          String?
  decisionToken   String   @unique // real Ed25519 signature
  actorId         String?
  enterpriseId    String?
  payloadHash     String
  createdAt       DateTime @default(now())
  @@index([actorId])
  @@index([enterpriseId])
  @@index([policy])
}

// ───────────────────────────────────────────────────────────
// ENGAGEMENT LAYER (GoFundMe-inspired, constitutional model)
// ───────────────────────────────────────────────────────────

/// Enterprise updates feed — founding operators post updates for capital partners.
/// The Brain AI auto-summarizes each update for different audiences.
model EnterpriseUpdate {
  id            String   @id @default(cuid())
  enterpriseId  String
  authorId      String
  title         String
  body          String
  attachmentsCid String? // IPFS CID for photos/documents
  // Brain AI generated fields
  aiSummary     String?  // 1-sentence TL;DR
  aiAudienceCapital String? // summary for capital partners
  aiAudienceCompliance String? // summary for FRA/regulators
  aiSentiment   String?  // positive, neutral, negative
  // Milestone celebration flag
  isMilestone   Boolean  @default(false)
  milestoneType String?  // "25pct", "50pct", "75pct", "100pct", "graduation"
  createdAt     DateTime @default(now())

  enterprise    Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Restrict)
  author        User       @relation("UpdateAuthor", fields: [authorId], references: [id])
  @@index([enterpriseId, createdAt])
  @@index([authorId])
}

/// Capital partner engagement tracking — Brain AI computes engagement scores.
model PartnerEngagement {
  id            String   @id @default(cuid())
  enterpriseId  String
  userId        String
  // Brain AI computed fields
  engagementScore Int    @default(0) // 0-100
  churnRisk     String   @default("low") // low, medium, high
  aiInsight     String?  // Brain AI recommendation
  lastAiUpdate  DateTime?
  // Tracking fields (updated by platform events)
  votesParticipated Int  @default(0)
  updatesRead   Int      @default(0)
  copilotQueries Int     @default(0)
  sessionCount  Int      @default(0)
  lastActiveAt  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enterprise    Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Restrict)
  user          User       @relation("EngagementUser", fields: [userId], references: [id])
  @@unique([enterpriseId, userId])
  @@index([enterpriseId])
  @@index([userId])
}

// ───────────────────────────────────────────────────────────
// ANNUAL CONSTITUTIONAL REPORT (PDPL-compliant public report)
