// ───────────────────────────────────────────────────────────
// CRYPTOGRAPHIC SUCCESSION (Blueprint Vol 16 §16.1)
// ───────────────────────────────────────────────────────────
/// A Constitutional Partner's cryptographic succession declaration. The
/// declarant (typically a Founding Operator, Manager, Board Member, or
/// >10% Capital Partner — mandatory per Vol 16 §16.1) files this to:
///
///   1. Designate a successor (internal or external) who will receive their
///      voting rights + economic interest on verified death / incapacitation.
///   2. List economic beneficiaries with explicit percentage splits.
///   3. Set conditions (onDeath, onIncapacitation, thresholdDays for the
///      90-day voting-proxy activation window).
///   4. Optionally appoint an emergency manager (must hold police clearance)
///      to bridge the transition.
///
/// Lifecycle: draft → filed → activated → executed.
///   - draft     — declarant is composing (no constitutional effect)
///   - filed     — declarant has signed; declaration is in force
///   - activated — voting proxy has been activated (90-day threshold met
///                 or death/incapacity verified)
///   - executed  — succession complete; ownership + voting rights transferred
model SuccessionDeclaration {
  id                     String   @id @default(cuid())
  userId                 String
  // The designated successor — if a platform user, their userId; otherwise null
  // and beneficiaryName / beneficiaryNationalId describe an external successor.
  beneficiaryUserId      String?
  beneficiaryName        String?
  beneficiaryNationalId  String?  // AES-GCM encrypted (see lib/aurienta/encryption)
  // JSON-encoded conditions: { onDeath: true, onIncapacitation: false, thresholdDays: 90 }
  conditions             String
  votingProxyActive      Boolean  @default(false)
  votingProxyActivatedAt DateTime?
  // Temporary manager appointed during transition (must hold valid police clearance)
  emergencyManagerId     String?
  status                 String   @default("draft") // draft, filed, activated, executed
  declaredAt             DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user                   User     @relation("SuccessionDeclarant", fields: [userId], references: [id], onDelete: Cascade)
  economicBeneficiaries  EconomicBeneficiary[]

  @@index([userId])
  @@index([status])
}

// ───────────────────────────────────────────────────────────
// ECONOMIC BENEFICIARIES (Blueprint Vol 16 §16.1)
// ───────────────────────────────────────────────────────────
/// Each succession declaration may list one or more economic beneficiaries
/// who inherit the declarant's economic interest (Equity Units, dividend
/// rights) on execution. Percentages must sum to 100 across the declaration
/// (validated by the CRE on file).
model EconomicBeneficiary {
  id                       String   @id @default(cuid())
  successionDeclarationId  String
  name                     String
  relationship             String   // spouse, child, sibling, parent, other
  percentage               Float    // 0-100; must sum to 100 across the declaration
  nationalIdLast4          String?  // AES-GCM encrypted (see lib/aurienta/encryption)

  successionDeclaration    SuccessionDeclaration @relation(fields: [successionDeclarationId], references: [id], onDelete: Cascade)

  @@index([successionDeclarationId])
}

// ───────────────────────────────────────────────────────────
// LAW FIRM WEBHOOK EVENTS (Blueprint Vol 5 §5.2)
// ───────────────────────────────────────────────────────────
/// Append-only log of every webhook event received from a law firm's escrow
/// system. Each row records: which firm sent it, the enterprise (if any) it
/// concerns, the event type, the raw payload, and whether the Ed25519
/// signature verified. Used for:
///   - Reconciliation (audit trail of every balance assertion + escrow event)
///   - Forensic reconstruction (re-derive raisedEgp / law-firm-account balance
///     from the raw event stream)
///   - Replay protection (the law firm can send a duplicate event ID; we
///     detect it via reference + receivedAt uniqueness checks at the API layer)
model LawFirmWebhookEvent {
  id              String   @id @default(cuid())
  lawFirmId       String
  enterpriseId    String?
  eventType       String   // escrow_received, escrow_released, escrow_refunded, balance_assertion
  amountEgp       Float?
  reference       String?  @unique // AUD-018: idempotency key — law-firm-side reference. NULL allowed (multiple), but non-NULL values must be unique.
  rawPayload      String   // JSON
  signatureValid  Boolean
  receivedAt      DateTime @default(now())

  lawFirm         LawFirm  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)

  @@index([lawFirmId])
  @@index([enterpriseId])
  @@index([eventType])
}

// ───────────────────────────────────────────────────────────
